{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Addon Forge",
  "version": "0.1.0",
  "identifier": "com.addonforge.wow",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Addon Forge — WoW Addon Updater",
        "width": 1280,
        "height": 840,
        "minWidth": 1000,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark",
        "backgroundColor": "#0b0b0e"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "publisher": "Addon Forge contributors",
    "copyright": "Copyright © 2026 Addon Forge contributors",
    "category": "Utility",
    "shortDescription": "World of Warcraft addon manager powered by CurseForge",
    "longDescription": "Addon Forge detects World of Warcraft installations, checks installed addons against CurseForge, and installs updates and new addons safely with backups.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
